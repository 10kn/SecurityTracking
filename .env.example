APP_NAME="Project Security Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=psm
DB_USERNAME=psm
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Project Security Manager (config/psm.php)
PSM_ADMIN_CHAT_WEBHOOK=
PSM_ADMIN_NEWS_WEBHOOK=
PSM_ALERT_LOCALE=vi
PSM_IMMEDIATE_SEVERITIES=critical,high
PSM_DEADLINE_CRITICAL_DAYS=3
PSM_DEADLINE_HIGH_DAYS=14
PSM_DEADLINE_MEDIUM_DAYS=30
PSM_DEADLINE_LOW_DAYS=90
PSM_ALERT_STUCK_AFTER_MINUTES=30
PSM_SCHEDULER_HEARTBEAT_URL=
PSM_DIGEST_TIME=08:00
PSM_DIGEST_DAYS=0,1,2,3,4,5,6
PSM_DIGEST_TIMEZONE=Asia/Ho_Chi_Minh
PSM_DIGEST_WEEKLY_DAY=1
PSM_NOTICE_RELEVANT_DAYS=14
PSM_NOTICE_COLLECT_DAYS=90
PSM_NOTICE_STALE_AFTER_MINUTES=120
ANTHROPIC_API_KEY=
PSM_NOTICE_CLASSIFIER_MODEL=claude-haiku-5-5
PSM_NOTICE_CLASSIFIER_EFFORT=low
PSM_NOTICE_CLASSIFIER_TIMEOUT=60
PSM_NOTICE_CLASSIFIER_ALERT_AFTER_MINUTES=60
PSM_IMMEDIATE_DEV_DEPENDENCIES=false
PSM_LOCKFILE_SUMMARY_THRESHOLD=3
PSM_PACKAGIST_URL=https://packagist.org
PSM_PACKAGIST_BATCH_SIZE=500
PSM_RUBYSEC_URL=https://github.com/rubysec/ruby-advisory-db/archive/refs/heads/master.tar.gz
PSM_OSV_URL=https://api.osv.dev/v1
PSM_OSV_BATCH_SIZE=1000
PSM_OSV_CONCURRENCY=10
PSM_PACKAGES_STALE_AFTER_MINUTES=720
PSM_PACKAGES_HTTP_TIMEOUT=30
PSM_GITHUB_APP_ID=
PSM_GITHUB_INSTALLATION_ID=
PSM_GITHUB_PRIVATE_KEY_PATH=
PSM_GITHUB_SYNC_TIME=06:30
PSM_GITHUB_SYNC_TIMEZONE=Asia/Ho_Chi_Minh
PSM_GITHUB_STALE_AFTER_MINUTES=1500
